version: '3.8'

networks:
  taskmanager-app:

services:
  backend:
    build:
      context: ./employee-performance-tracker
      dockerfile: Dockerfile
    ports:
      - "8011:8011"
    environment:
      - SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/employee_db 
      - SPRING_DATASOURCE_USERNAME=postgres
      - SPRING_DATASOURCE_PASSWORD=bcb@1234  
    depends_on:
      - postgres  
    networks:
      - performance-tracker-app

  postgres:
    image: postgres:13
    container_name: postgres_db
    environment:
      POSTGRES_DB: employee_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: bcb@1234 
    ports:
      - "5432:5432"  
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - performance-tracker-app

volumes:
  postgres-data:  
